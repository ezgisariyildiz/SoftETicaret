@using ETicaretData.ViewModels
@model ShippingDetails
@{
    ViewData["Title"] = "CheckOut";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1>CheckOut</h1>
<div class="container">
    <div class="row">
        <div class="col-md-12">
            <h2>Sipariş Bilgileriniz</h2>
            <p>Lütfen sipariş bilgilerinizi doldurunuz.</p>
            <hr />

            @using (Html.BeginForm())
            {
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                <div class="row mb-3">
                    <label for="UserName" class="col-sm-2 col-form-label">Username</label>
                    <div class="col-sm-6">
                        @if (User.Identity.Name != null)
                        {
                            <input type="text" class="form-control" id="UserName" asp-for="UserName" value="@User.Identity.Name" />
                        }
                        else
                        {
                            <input type="text" class="form-control" id="UserName" asp-for="UserName" placeholder="Username" />
                        }
                        <span asp-validation-for="UserName" class="text-danger"></span>
                    </div>
                </div>

                <div class="row mb-3">
                    <label for="AddressTitle" class="col-sm-2 col-form-label">Adres Tanımı</label>
                    <div class="col-sm-6">
                        @Html.TextBoxFor(x => x.AddressTitle, new { @class = "form-control", id = "AddressTitle" })
                        <span asp-validation-for="AddressTitle" class="text-danger"></span>
                    </div>
                </div>

                <div class="row mb-3">
                    <label for="Address" class="col-sm-2 col-form-label">Adres</label>
                    <div class="col-sm-6">
                        @Html.TextBoxFor(x => x.Address, new { @class = "form-control", id = "Address" })
                        <span asp-validation-for="Address" class="text-danger"></span>
                    </div>
                </div>

                <div class="row mb-3">
                    <label for="City" class="col-sm-2 col-form-label">Şehir</label>
                    <div class="col-sm-6">
                        @Html.TextBoxFor(x => x.City, new { @class = "form-control", id = "City" })
                        <span asp-validation-for="City" class="text-danger"></span>
                    </div>
                </div>

                <div class="row">
                    <div class="col-sm-2"></div>
                    <div class="col-sm-6">
                        <button type="submit" class="btn btn-primary">Gönder</button>
                    </div>
                </div>
            }

        </div>
    </div>
</div>
